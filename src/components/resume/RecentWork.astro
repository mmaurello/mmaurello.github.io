---
import type { RecentWorkEntry } from "../../data/resume";
import Section from "./Section.astro";

interface Props {
  items: RecentWorkEntry[];
}

const { items } = Astro.props;

const carouselItems = items.map((item) => ({
  ...item,
  images: [item.hero, ...item.gallery],
}));

const navButtonClass =
  "absolute top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white text-accent shadow-sm transition-[opacity,background-color,border-color,color] duration-200 hover:border-accent hover:bg-accent hover:text-white focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-30 dark:border-border dark:bg-surface-raised dark:text-accent-muted dark:hover:border-accent dark:hover:bg-accent dark:hover:text-white sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100";

const dotClass =
  "h-2 w-2 shrink-0 rounded-full bg-slate-300 transition-colors duration-150 hover:bg-accent/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-current:bg-accent dark:bg-stone-600 dark:hover:bg-accent-muted dark:aria-current:bg-accent";
---

<Section title="Recent Work" id="recent-work" class="print:hidden">
  <p class="mb-5 text-[0.9375rem] leading-relaxed text-slate-600 dark:text-stone-400">
    Production dApps built at Opslayer — representative of recent end-to-end ownership.
  </p>

  <div class="flex flex-col gap-8">
    {carouselItems.map((item) => (
      <article
        class="flex flex-col gap-4"
        data-work-carousel
        data-images={JSON.stringify(item.images)}
      >
        <div class="flex flex-col gap-2">
          {item.url ? (
            <h3 class="m-0 text-[1.0625rem] font-semibold text-slate-800 dark:text-stone-100">
              <a
                href={item.url}
                class="text-inherit no-underline transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.name}
              </a>
            </h3>
          ) : (
            <h3 class="m-0 text-[1.0625rem] font-semibold text-slate-800 dark:text-stone-100">
              {item.name}
            </h3>
          )}
          <p class="m-0 text-sm text-slate-500 dark:text-stone-400">
            {item.company} · {item.role}
          </p>
          <p class="m-0 text-[0.9375rem] leading-relaxed text-slate-700 dark:text-stone-300">
            {item.description}
          </p>
        </div>

        <div
          class="group relative rounded-xl border border-slate-200 bg-slate-100/80 p-3 dark:border-border dark:bg-surface-muted sm:p-4"
        >
          <div class="relative flex min-h-[12rem] items-center justify-center sm:min-h-[18rem]">
            <button
              type="button"
              data-work-prev
              aria-label="Previous screenshot"
              class:list={[navButtonClass, "left-2 sm:left-3"]}
            >
              <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M12.707 5.293a1 1 0 0 1 0 1.414L9.414 10l3.293 3.293a1 1 0 0 1-1.414 1.414l-4-4a1 1 0 0 1 0-1.414l4-4a1 1 0 0 1 1.414 0Z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>

            <div data-work-viewport class="w-full overflow-hidden rounded-lg">
              <div
                data-work-track
                class="flex motion-reduce:transition-none transition-transform duration-300 ease-in-out"
              >
                {item.images.map((image, slideIndex) => (
                  <button
                    type="button"
                    data-work-expand
                    data-slide-index={slideIndex}
                    class="flex min-w-full max-h-[min(18rem,55vh)] cursor-zoom-in items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:max-h-[min(26rem,62vh)]"
                    aria-label={`View screenshot ${slideIndex + 1} full size`}
                  >
                    <img
                      src={image.src}
                      alt={image.alt}
                      width={1200}
                      loading="lazy"
                      decoding="async"
                      class="max-h-[min(18rem,55vh)] w-full object-contain sm:max-h-[min(26rem,62vh)]"
                    />
                  </button>
                ))}
              </div>
            </div>

            <button
              type="button"
              data-work-next
              aria-label="Next screenshot"
              class:list={[navButtonClass, "right-2 sm:right-3"]}
            >
              <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 0 1 0-1.414L10.586 10 7.293 6.707a1 1 0 0 1 1.414-1.414l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414 0Z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
          </div>

          <div class="mt-3 flex items-center justify-between gap-3">
            <fieldset class="m-0 flex min-w-0 items-center gap-2 border-0 p-0">
              <legend class="sr-only">{item.name} screenshot navigation</legend>
              {item.images.map((_, index) => (
                <button
                  type="button"
                  data-work-dot
                  data-index={index}
                  aria-label={`Go to screenshot ${index + 1}`}
                  aria-current={index === 0 ? "true" : "false"}
                  class={dotClass}
                />
              ))}
            </fieldset>
            <p data-work-counter class="m-0 text-xs text-slate-500 dark:text-stone-400">
              1 / {item.images.length}
            </p>
          </div>

          <p class="m-0 mt-2 text-center text-xs text-slate-500 dark:text-stone-500">
            Click the image to view full size
          </p>
        </div>
      </article>
    ))}
  </div>

  <dialog
    id="work-lightbox"
    class="m-0 max-h-[100dvh] max-w-[100vw] w-full border-0 bg-transparent p-0 backdrop:bg-black/80 open:flex open:items-center open:justify-center"
    aria-label="Screenshot preview"
  >
    <div class="relative flex max-h-[100dvh] w-full max-w-6xl flex-col gap-3 p-4 sm:p-6">
      <div class="flex items-center justify-between gap-3">
        <p id="work-lightbox-caption" class="m-0 text-sm text-white/90" />
        <button
          type="button"
          id="work-lightbox-close"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white transition-colors hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label="Close preview"
        >
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path
              d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"
            />
          </svg>
        </button>
      </div>

      <div class="relative flex min-h-0 flex-1 items-center justify-center">
        <button
          type="button"
          id="work-lightbox-prev"
          aria-label="Previous screenshot"
          class="absolute left-0 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white transition-colors hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-30 sm:left-2"
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M12.707 5.293a1 1 0 0 1 0 1.414L9.414 10l3.293 3.293a1 1 0 0 1-1.414 1.414l-4-4a1 1 0 0 1 0-1.414l4-4a1 1 0 0 1 1.414 0Z"
              clip-rule="evenodd"
            />
          </svg>
        </button>

        <img
          id="work-lightbox-image"
          alt=""
          class="max-h-[calc(100dvh-8rem)] w-full object-contain"
        >

        <button
          type="button"
          id="work-lightbox-next"
          aria-label="Next screenshot"
          class="absolute right-0 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white transition-colors hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-30 sm:right-2"
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 0 1 0-1.414L10.586 10 7.293 6.707a1 1 0 0 1 1.414-1.414l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414 0Z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>

      <p id="work-lightbox-counter" class="m-0 text-center text-xs text-white/70" />
    </div>
  </dialog>
</Section>

<script>
interface WorkImage {
  src: string;
  alt: string;
}

function parseImages(raw: string | undefined): WorkImage[] {
  if (!raw) return [];

  try {
    const parsed = JSON.parse(raw) as WorkImage[];
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

function setupWorkCarousels() {
  const dialog = document.getElementById("work-lightbox");
  const lightboxImage = document.getElementById("work-lightbox-image");
  const lightboxCaption = document.getElementById("work-lightbox-caption");
  const lightboxCounter = document.getElementById("work-lightbox-counter");
  const lightboxClose = document.getElementById("work-lightbox-close");
  const lightboxPrev = document.getElementById("work-lightbox-prev");
  const lightboxNext = document.getElementById("work-lightbox-next");

  if (
    !(dialog instanceof HTMLDialogElement) ||
    !(lightboxImage instanceof HTMLImageElement) ||
    !(lightboxCaption instanceof HTMLElement) ||
    !(lightboxCounter instanceof HTMLElement) ||
    !(lightboxClose instanceof HTMLButtonElement) ||
    !(lightboxPrev instanceof HTMLButtonElement) ||
    !(lightboxNext instanceof HTMLButtonElement)
  ) {
    return;
  }

  if (dialog.dataset.initialized === "true") return;
  dialog.dataset.initialized = "true";

  const modal = dialog;
  const lbImage = lightboxImage;
  const lbCaption = lightboxCaption;
  const lbCounter = lightboxCounter;
  const lbClose = lightboxClose;
  const lbPrev = lightboxPrev;
  const lbNext = lightboxNext;

  let lightboxImages: WorkImage[] = [];
  let lightboxIndex = 0;

  function updateLightbox() {
    const image = lightboxImages[lightboxIndex];
    if (!image) return;

    lbImage.src = image.src;
    lbImage.alt = image.alt;
    lbCaption.textContent = image.alt;
    lbCounter.textContent = `${lightboxIndex + 1} / ${lightboxImages.length}`;
    lbPrev.disabled = lightboxImages.length <= 1;
    lbNext.disabled = lightboxImages.length <= 1;
  }

  function openLightbox(images: WorkImage[], index: number) {
    lightboxImages = images;
    lightboxIndex = index;
    updateLightbox();
    modal.showModal();
  }

  function closeLightbox() {
    modal.close();
    lbImage.removeAttribute("src");
  }

  function stepLightbox(delta: number) {
    if (lightboxImages.length === 0) return;
    lightboxIndex =
      (lightboxIndex + delta + lightboxImages.length) % lightboxImages.length;
    updateLightbox();
  }

  lbClose.addEventListener("click", closeLightbox);
  lbPrev.addEventListener("click", () => stepLightbox(-1));
  lbNext.addEventListener("click", () => stepLightbox(1));

  modal.addEventListener("click", (event) => {
    if (event.target === modal) closeLightbox();
  });

  modal.addEventListener("cancel", () => {
    lbImage.removeAttribute("src");
  });

  modal.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      stepLightbox(-1);
    }

    if (event.key === "ArrowRight") {
      event.preventDefault();
      stepLightbox(1);
    }
  });

  document.querySelectorAll<HTMLElement>("[data-work-carousel]").forEach((carousel) => {
    const images = parseImages(carousel.dataset.images);
    if (images.length === 0) return;

    const track = carousel.querySelector<HTMLElement>("[data-work-track]");
    const expandButtons =
      carousel.querySelectorAll<HTMLButtonElement>("[data-work-expand]");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-work-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-work-next]");
    const counter = carousel.querySelector<HTMLElement>("[data-work-counter]");
    const dots = carousel.querySelectorAll<HTMLButtonElement>("[data-work-dot]");

    if (!track || !prev || !next || !counter) return;

    const trackEl = track;
    const prevEl = prev;
    const nextEl = next;
    const counterEl = counter;

    let index = 0;

    function updateCarousel() {
      trackEl.style.transform = `translateX(-${index * 100}%)`;
      counterEl.textContent = `${index + 1} / ${images.length}`;
      prevEl.disabled = images.length <= 1;
      nextEl.disabled = images.length <= 1;

      dots.forEach((dot) => {
        const dotIndex = Number(dot.dataset.index);
        dot.setAttribute("aria-current", dotIndex === index ? "true" : "false");
      });
    }

    function goTo(nextIndex: number) {
      index = (nextIndex + images.length) % images.length;
      updateCarousel();
    }

    prevEl.addEventListener("click", () => goTo(index - 1));
    nextEl.addEventListener("click", () => goTo(index + 1));

    expandButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const slideIndex = Number(button.dataset.slideIndex);
        openLightbox(images, Number.isNaN(slideIndex) ? index : slideIndex);
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const dotIndex = Number(dot.dataset.index);
        if (!Number.isNaN(dotIndex)) goTo(dotIndex);
      });
    });

    updateCarousel();
  });
}

setupWorkCarousels();
document.addEventListener("astro:page-load", setupWorkCarousels);
</script>
