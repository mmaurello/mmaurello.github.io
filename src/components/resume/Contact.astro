---
import Section from "./Section.astro";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const isConfigured = accessKey.length > 0;

const inputClass =
  "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder:text-slate-400 focus:border-accent focus:ring-2 focus:ring-accent-light focus:outline-none dark:border-border dark:bg-surface dark:text-stone-100 dark:placeholder:text-stone-500";
const labelClass =
  "mb-1 block text-xs font-semibold tracking-wide text-slate-600 uppercase dark:text-stone-400";
---

<Section title="Contact" id="contact" class="print:hidden">
  <p class="mb-4 text-[0.9375rem] leading-relaxed text-slate-600 dark:text-stone-400">
    Interested in working together? Send a message and I'll get back to you.
  </p>

  {isConfigured ? (
			<form id="contact-form" class="flex flex-col gap-4" novalidate>
				<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

				<div>
					<label for="contact-name" class={labelClass}>
						Name
					</label>
					<input
						type="text"
						id="contact-name"
						name="name"
						required
						autocomplete="name"
						class={inputClass}
						placeholder="Your name"
					/>
				</div>

				<div>
					<label for="contact-email" class={labelClass}>
						Email
					</label>
					<input
						type="email"
						id="contact-email"
						name="email"
						required
						autocomplete="email"
						class={inputClass}
						placeholder="you@example.com"
					/>
				</div>

				<div>
					<label for="contact-message" class={labelClass}>
						Message
					</label>
					<textarea
						id="contact-message"
						name="message"
						required
						rows={4}
						class={`${inputClass} resize-y min-h-24`}
						placeholder="What would you like to discuss?"
					/>
				</div>

				<div class="h-captcha" data-captcha="true" />

				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<button
						type="submit"
						id="contact-submit"
						class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60"
					>
						Send message
					</button>
					<p id="contact-status" class="text-sm text-slate-500 dark:text-stone-400" role="status" aria-live="polite" />
				</div>
			</form>
		) : (
			<p class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
				Contact form is not configured yet. Add your Web3Forms access key to{' '}
				<code class="rounded bg-amber-100 px-1 py-0.5 text-xs dark:bg-amber-900">PUBLIC_WEB3FORMS_ACCESS_KEY</code> in{' '}
				<code class="rounded bg-amber-100 px-1 py-0.5 text-xs dark:bg-amber-900">.env</code> (see README).
			</p>
		)}
</Section>

{isConfigured && (
		<>
			<script define:vars={{ accessKey }}>
				const form = document.getElementById('contact-form');
				const submitBtn = document.getElementById('contact-submit');
				const statusEl = document.getElementById('contact-status');

				// Load the Web3Forms client script (which pulls in hCaptcha) only once
				// the visitor interacts with the form. This keeps the heavy third-party
				// hCaptcha script — and its cookies / deprecated APIs — off the initial
				// page load, improving Performance and Best Practices scores.
				let captchaScriptLoaded = false;
				function loadCaptchaScript() {
					if (captchaScriptLoaded) return;
					captchaScriptLoaded = true;
					const script = document.createElement('script');
					script.src = 'https://web3forms.com/client/script.js';
					script.async = true;
					script.defer = true;
					document.body.appendChild(script);
				}

				if (form) {
					form.addEventListener('focusin', loadCaptchaScript, { once: true });
					form.addEventListener('pointerdown', loadCaptchaScript, { once: true });
				}

				function resetCaptcha() {
					if (typeof hcaptcha !== 'undefined') {
						hcaptcha.reset();
					}
				}

				function getCaptchaToken(formEl) {
					const captchaField = formEl.querySelector('[name="h-captcha-response"]');
					return captchaField instanceof HTMLTextAreaElement ? captchaField.value : '';
				}

				if (form instanceof HTMLFormElement && submitBtn instanceof HTMLButtonElement && statusEl) {
					form.addEventListener('submit', async (event) => {
						event.preventDefault();

						if (!form.checkValidity()) {
							form.reportValidity();
							return;
						}

						const captchaToken = getCaptchaToken(form);
						if (!captchaToken) {
							statusEl.textContent = 'Please complete the captcha.';
							statusEl.className = 'text-sm font-medium text-red-700 dark:text-red-400';
							return;
						}

						const formData = new FormData(form);
						const payload = {
							access_key: accessKey,
							name: formData.get('name'),
							email: formData.get('email'),
							message: formData.get('message'),
							subject: `Resume contact from ${formData.get('name')}`,
							botcheck: formData.get('botcheck') ?? '',
							'h-captcha-response': captchaToken,
						};

						submitBtn.disabled = true;
						submitBtn.textContent = 'Sending…';
						statusEl.textContent = '';
						statusEl.className = 'text-sm text-slate-500 dark:text-stone-400';

						try {
							const response = await fetch('https://api.web3forms.com/submit', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
								body: JSON.stringify(payload),
							});

							const result = await response.json();

							if (response.ok && result.success) {
								form.reset();
								resetCaptcha();
								statusEl.textContent = 'Message sent — thank you!';
								statusEl.className = 'text-sm font-medium text-emerald-700 dark:text-emerald-400';
							} else {
								resetCaptcha();
								statusEl.textContent = result.message ?? 'Something went wrong. Please try again.';
								statusEl.className = 'text-sm font-medium text-red-700 dark:text-red-400';
							}
						} catch {
							resetCaptcha();
							statusEl.textContent = 'Network error. Please try again later.';
							statusEl.className = 'text-sm font-medium text-red-700 dark:text-red-400';
						} finally {
							submitBtn.disabled = false;
							submitBtn.textContent = 'Send message';
						}
					});
				}
			</script>
		</>
	)}
