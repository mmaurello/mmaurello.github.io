---
import type { ExperienceEntry } from "../../data/resume";
import Section from "./Section.astro";
import SkillChip from "./SkillChip.astro";

interface Props {
  experience: ExperienceEntry[];
  title?: string;
  compact?: boolean;
  id?: string;
  class?: string;
}

const {
  experience,
  title = "Experience",
  compact = false,
  id,
  class: className,
} = Astro.props;
---

<Section title={title} id={id} class={className}>
  <ul class="m-0 flex list-none flex-col gap-6 p-0 print:gap-3">
    {experience.map((job, index) => (
      <li
        class:list={[
          compact ? "pb-4 print:pb-2" : "pb-6 print:pb-3",
          index < experience.length - 1 && "border-b border-slate-200 dark:border-border",
          !compact && "print:break-inside-avoid",
        ]}
      >
        <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between print:mb-1.5">
          <div class="min-w-0">
            <h3
              class:list={[
                "m-0 font-semibold text-slate-800 dark:text-stone-100",
                compact ? "text-[0.9375rem]" : "text-[1.0625rem] print:text-[1rem]",
              ]}
            >
              {job.role}
            </h3>
            <p class="mt-0.5 text-sm text-slate-500 dark:text-stone-400 print:text-black">
              {job.company} · {job.location}
            </p>
          </div>
          <p class="m-0 shrink-0 text-sm font-medium whitespace-nowrap text-accent print:text-black">
            {job.startDate} – {job.endDate}
          </p>
        </div>
        {job.roles && job.roles.length > 0 && (
          <ul class="m-0 mb-3 list-none p-0 text-xs leading-relaxed text-slate-500 dark:text-stone-400 print:mb-1.5 print:text-black">
            {job.roles.map((role) => (
              <li>
                <span class="font-medium text-slate-700 dark:text-stone-400 print:text-black">
                  {role.role}
                </span>
                <span class="text-slate-500 dark:text-stone-500 print:text-black">
                  {" "}({role.startDate} – {role.endDate})
                </span>
              </li>
            ))}
          </ul>
        )}
        {!compact && (
          <>
            <ul class="m-0 flex list-disc flex-col gap-1.5 pl-5 print:gap-1">
              {job.highlights.map((highlight) => (
                <li class="text-[0.9375rem] leading-relaxed text-slate-800 dark:text-stone-200 print:text-[0.8125rem] print:leading-snug">
                  {highlight}
                </li>
              ))}
            </ul>
            {job.skills && job.skills.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5 print:hidden">
                {job.skills.map((skill) => (
                  <SkillChip label={skill} />
                ))}
              </div>
            )}
          </>
        )}
      </li>
    ))}
  </ul>
</Section>
