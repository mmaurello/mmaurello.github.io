---
import type { ExperienceEntry } from "../../data/resume";
import Section from "./Section.astro";
import SkillChip from "./SkillChip.astro";

interface Props {
  experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

<Section title="Experience">
  <ul class="m-0 flex list-none flex-col gap-6 p-0">
    {experience.map((job, index) => (
				<li
					class:list={[
						'pb-6',
						index < experience.length - 1 && 'border-b border-slate-200 dark:border-border',
					]}
				>
					<div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
						<div>
							<h3 class="m-0 text-[1.0625rem] font-semibold text-slate-800 dark:text-stone-100">{job.role}</h3>
							<p class="mt-0.5 text-sm text-slate-500 dark:text-stone-400">
								{job.company} · {job.location}
							</p>
						</div>
						<p class="m-0 text-sm font-medium whitespace-nowrap text-accent print:text-black">
							{job.startDate} – {job.endDate}
						</p>
					</div>
					<ul class="m-0 flex list-disc flex-col gap-1.5 pl-5">
						{job.highlights.map((highlight) => (
							<li class="text-[0.9375rem] leading-relaxed text-slate-800 dark:text-stone-200">{highlight}</li>
						))}
					</ul>
					{job.skills && job.skills.length > 0 && (
						<div class="mt-3 flex flex-wrap gap-1.5">
							{job.skills.map((skill) => (
								<SkillChip label={skill} />
							))}
						</div>
					)}
				</li>
			))}
  </ul>
</Section>
