---
import type { EducationEntry } from '../../data/resume';
import Section from './Section.astro';

interface Props {
	education: EducationEntry[];
}

const { education } = Astro.props;
---

<Section title="Education">
	<ul class="entry-list">
		{
			education.map((edu) => (
				<li class="entry">
					<div class="entry-header">
						<div>
							<h3 class="entry-title">{edu.degree}</h3>
							<p class="entry-subtitle">
								{edu.institution} · {edu.location}
							</p>
							{edu.details && <p class="entry-details">{edu.details}</p>}
						</div>
						<p class="entry-dates">
							{edu.startDate} – {edu.endDate}
						</p>
					</div>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.entry-header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.entry-title {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.entry-subtitle {
		margin: 0.125rem 0 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.entry-details {
		margin: 0.375rem 0 0;
		font-size: 0.875rem;
		color: var(--color-text);
	}

	.entry-dates {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-accent);
		white-space: nowrap;
	}

	@media (min-width: 640px) {
		.entry-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
		}
	}
</style>
