---
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
		'reveal scroll-mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-7 dark:border-border dark:bg-surface-raised print:translate-none print:opacity-100 print:transition-none print:rounded-none print:border-0 print:border-b print:border-gray-300 print:bg-white print:p-2 print:shadow-none',
		className,
	]}
>
  <h2
    class="mb-4 border-b-2 border-accent-light pb-2 text-xs font-bold tracking-widest text-accent uppercase print:mb-1.5 print:border-gray-300 print:pb-0.5 print:text-black"
  >
    {title}
  </h2>
  <slot />
</section>
