---
import type { Header } from "../../data/resume";
import { HEADER_SHADER_ENABLED } from "../../lib/header-shader";
import DownloadPdfButton from "./DownloadPdfButton.astro";
import HeaderAccent from "./HeaderAccent.astro";
import HeaderIconTooltip from "./HeaderIconTooltip.astro";

interface Props {
  header: Header;
}

const { header } = Astro.props;

function findLink(label: string) {
  return header.links.find((link) => link.label.toLowerCase() === label.toLowerCase());
}

const linkedInLink = findLink("LinkedIn");
const githubLink = findLink("GitHub");

const pdfFilename = `${header.name.replace(/\s+/g, "_")}_Resume`;

const chipBase =
  "inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-800 no-underline transition-colors hover:border-accent hover:text-accent dark:border-border dark:bg-surface-muted dark:text-stone-200 print:border-gray-300 print:bg-transparent print:text-black print:no-underline";
---

<header
  id="resume-header"
  class="reveal relative isolate flex flex-col gap-4 rounded-xl border border-slate-200 p-6 shadow-sm sm:p-7 dark:border-border print:translate-none print:opacity-100 print:transition-none print:border-gray-300 print:shadow-none print:break-inside-avoid"
>
  <div
    class="absolute inset-0 overflow-hidden rounded-xl bg-white dark:bg-surface-raised print:bg-white"
    aria-hidden="true"
  ></div>
  <canvas
    id="header-shader"
    class:list={[
      "pointer-events-none absolute inset-0 z-[1] h-full w-full overflow-hidden rounded-xl mix-blend-multiply dark:mix-blend-normal print:hidden",
      !HEADER_SHADER_ENABLED && "hidden",
    ]}
    aria-hidden="true"
  ></canvas>
  <div class="relative z-10 grid grid-cols-[1fr_auto] items-start gap-x-4 gap-y-4 sm:gap-x-5">
    <div>
      <h1
        class="m-0 flex items-center gap-2.5 text-3xl font-bold tracking-tight text-slate-800 sm:gap-3 sm:text-4xl dark:text-stone-100"
      >
        <!-- <HeaderAccent /> -->
        <span>{header.name}</span>
      </h1>
      <p class="mt-1 text-lg font-medium text-accent print:text-black">
        {header.title}
      </p>
    </div>
    <div class="flex shrink-0 items-start gap-2">
      <HeaderIconTooltip
        kind="location"
        ariaLabel={`Location: ${header.location}`}
        tooltip={header.location}
      />
      {linkedInLink && (
        <HeaderIconTooltip
          kind="linkedin"
          href={linkedInLink.url}
          ariaLabel="LinkedIn profile"
        />
      )}
      {githubLink && (
        <HeaderIconTooltip
          kind="github"
          href={githubLink.url}
          ariaLabel="GitHub profile"
        />
      )}
    </div>
  </div>
  <div class="relative z-10 flex justify-end gap-2">
    <DownloadPdfButton filename={pdfFilename} class={chipBase} />
    <a href="#contact" class={chipBase}>Contact</a>
  </div>
</header>

<script>
import { HEADER_SHADER_ENABLED, initHeaderShader } from "../../lib/header-shader";

let cleanupShader: (() => void) | null = null;

function setupHeaderShader() {
  if (!HEADER_SHADER_ENABLED) return;

  const canvas = document.getElementById("header-shader");
  const header = document.getElementById("resume-header");
  if (!(canvas instanceof HTMLCanvasElement) || !(header instanceof HTMLElement)) {
    return;
  }

  cleanupShader?.();
  cleanupShader = initHeaderShader(canvas, header);
}

setupHeaderShader();
document.addEventListener("astro:page-load", setupHeaderShader);
</script>
