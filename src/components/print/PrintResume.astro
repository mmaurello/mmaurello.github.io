---
import { getPrintResume } from "../../data/print-resume";
import type { ResumeVariant } from "../../data/resume";

interface Props {
  variant?: ResumeVariant;
}

const { variant = "general" } = Astro.props;
const { header, summary, experience, earlierRoles, education, skills, certifications, languages } =
  getPrintResume(variant);

function displayUrl(url: string) {
  return url.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");
}

const locationLine = [header.location, header.workAuthorization].filter(Boolean).join(" · ");
const sectionHeading =
  "mb-1.5 border-b border-gray-400 pb-0.5 text-[7.5pt] font-bold tracking-[0.12em] uppercase";
---

<article class="text-[9pt] leading-[1.35]">
  <header class="mb-2.5">
    <h1 class="m-0 text-[19pt] leading-tight font-bold tracking-tight">{header.name}</h1>
    <p class="m-0 mt-0.5 text-[10.5pt] font-medium">{header.title}</p>
    <p class="m-0 mt-1 text-[8.5pt]">{locationLine}</p>
    <p class="m-0 mt-1.5 text-[8.5pt]">
      {header.links.map((link, index) => (
        <>
          {index > 0 && <span> · </span>}
          <span class="font-semibold">{link.label}:</span>{" "}
          <a href={link.url} class="text-black underline underline-offset-2">
            {displayUrl(link.url)}
          </a>
        </>
      ))}
    </p>
  </header>

  <section class="mb-2.5">
    <h2 class={sectionHeading}>Summary</h2>
    <p class="m-0 text-justify">{summary}</p>
  </section>

  <section class="mb-2.5">
    <h2 class={sectionHeading}>Experience</h2>
    <div class="flex flex-col gap-2">
      {experience.map((job) => (
        <div class="break-inside-avoid">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="m-0 text-[10pt] font-semibold">
              {job.role} <span class="font-normal">— {job.company}</span>
            </h3>
            <span class="shrink-0 text-[8.5pt] whitespace-nowrap">{job.dates}</span>
          </div>
          <p class="m-0 text-[8.5pt] text-gray-700">{job.location}</p>
          {job.progression && job.progression.length > 0 && (
            <ul class="m-0 mt-1 list-none p-0 text-[8pt] text-gray-700">
              {job.progression.map((role) => (
                <li>
                  <span class="font-medium">{role.role}</span>
                  <span class="text-gray-600"> ({role.dates})</span>
                </li>
              ))}
            </ul>
          )}
          <ul class="m-0 mt-1 flex list-disc flex-col gap-0.5 pl-4">
            {job.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {earlierRoles.length > 0 && (
    <section class="mb-2.5 break-inside-avoid">
      <h2 class={sectionHeading}>Earlier Roles</h2>
      <ul class="m-0 flex list-disc flex-col gap-0.5 pl-4">
        {earlierRoles.map((role) => (
          <li class="text-[8.5pt]">{role}</li>
        ))}
      </ul>
    </section>
  )}

  <section class="mb-2.5 break-inside-avoid">
    <h2 class={sectionHeading}>Skills</h2>
    <div class="flex flex-col gap-1.5">
      {skills.map((group) =>
        group.variant === "list" ? (
          <div>
            <p class="m-0 font-semibold">{group.category}</p>
            <ul class="m-0 mt-0.5 flex list-disc flex-col gap-0.5 pl-4">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="m-0">
            <span class="font-semibold">{group.category}:</span> {group.items.join(", ")}
          </p>
        ),
      )}
    </div>
  </section>

  <section class="mb-2.5 break-inside-avoid">
    <h2 class={sectionHeading}>Education</h2>
    <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
      {education.map((edu) => (
        <li>
          <span class="font-semibold">{edu.degree}</span>
          <span class="text-gray-700"> — {edu.institution} · {edu.location}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="break-inside-avoid">
    <h2 class={sectionHeading}>Certifications & Languages</h2>
    <p class="m-0">
      <span class="font-semibold">Certifications:</span>{" "}
      {certifications.map((cert) => `${cert.name} (${cert.issuer}, ${cert.year})`).join(" · ")}
    </p>
    <p class="m-0">
      <span class="font-semibold">Languages:</span>{" "}
      {languages.map((lang) => `${lang.name} (${lang.level})`).join(" · ")}
    </p>
  </section>
</article>
